{
  "version": 5,
  "configurePresets": [
    {
      "name": "core",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../AgentFiles/build/core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FORGE_BUILD_EDITOR": "OFF",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/../AgentFiles/dependencies/core",
        "FORGE_BUILD_UI_PRESENTER": "ON"
      }
    },
    {
      "name": "windows-editor",
      "inherits": "core",
      "binaryDir": "${sourceDir}/../AgentFiles/build/windows-editor",
      "cacheVariables": {
        "FORGE_BUILD_EDITOR": "ON",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/../AgentFiles/dependencies/windows-editor"
      }
    },
    {
      "name": "native-sdk",
      "inherits": "core",
      "binaryDir": "${sourceDir}/../AgentFiles/build/native-sdk",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FORGE_ENABLE_NATIVE_SDK": "ON",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/../AgentFiles/dependencies/native-sdk",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "windows-editor",
      "configurePreset": "windows-editor"
    },
    {
      "name": "native-sdk",
      "configurePreset": "native-sdk"
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-sdk",
      "configurePreset": "native-sdk",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
