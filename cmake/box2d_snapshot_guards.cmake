# Selected Box2D 3.2.0 integration repair. Compile a checked build-tree copy;
# preserve the immutable upstream checkout, copyright and MIT attribution.
set(_forge_box2d_snapshot "${box2d_SOURCE_DIR}/src/snapshot.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_forge_box2d_snapshot}")
file(READ "${_forge_box2d_snapshot}" _forge_box2d_snapshot_text)
string(REPLACE "\r\n" "\n" _forge_box2d_snapshot_text "${_forge_box2d_snapshot_text}")
string(SHA256 _forge_box2d_snapshot_hash "${_forge_box2d_snapshot_text}")
if(NOT _forge_box2d_snapshot_hash STREQUAL "79ddfef9fd1466c2d5eba999ad284b6e432f66912fd9dd5512288fe2d0967ed1")
 message(FATAL_ERROR "Box2D snapshot source changed; review/remove the exact-pin empty-array guards")
endif()
foreach(_forge_guard IN ITEMS "chainShapes|chainCount|b2ChainShape" "sensors|sensorCount|b2Sensor" "islands|islandCount|b2Island")
 string(REPLACE "|" ";" _forge_guard_fields "${_forge_guard}")
 list(GET _forge_guard_fields 0 _forge_array)
 list(GET _forge_guard_fields 1 _forge_count)
 list(GET _forge_guard_fields 2 _forge_type)
 set(_forge_clear "memset( world->${_forge_array}.data, 0, ${_forge_count} * sizeof( ${_forge_type} ) );")
 string(FIND "${_forge_box2d_snapshot_text}" "${_forge_clear}" _forge_clear_position)
 if(_forge_clear_position LESS 0)
  message(FATAL_ERROR "Box2D snapshot empty-array guard no longer matches ${_forge_array}")
 endif()
 string(REPLACE "${_forge_clear}" "if ( ${_forge_count} > 0 )\n\t\t\t{\n\t\t\t\t${_forge_clear}\n\t\t\t}"
        _forge_box2d_snapshot_text "${_forge_box2d_snapshot_text}")
endforeach()
set(_forge_box2d_snapshot_fixed "${CMAKE_BINARY_DIR}/forge-box2d/snapshot.c")
file(CONFIGURE OUTPUT "${_forge_box2d_snapshot_fixed}" CONTENT "${_forge_box2d_snapshot_text}" @ONLY NEWLINE_STYLE LF)
get_target_property(_forge_box2d_source_dir box2d SOURCE_DIR)
get_target_property(_forge_box2d_sources box2d SOURCES)
set(_forge_box2d_fixed_sources "")
set(_forge_box2d_replacements 0)
foreach(_forge_source IN LISTS _forge_box2d_sources)
 get_filename_component(_forge_name "${_forge_source}" NAME)
 if(_forge_name STREQUAL "snapshot.c")
  list(APPEND _forge_box2d_fixed_sources "${_forge_box2d_snapshot_fixed}")
  math(EXPR _forge_box2d_replacements "${_forge_box2d_replacements}+1")
 elseif(IS_ABSOLUTE "${_forge_source}" OR _forge_source MATCHES "^\\$<")
  list(APPEND _forge_box2d_fixed_sources "${_forge_source}")
 else()
  list(APPEND _forge_box2d_fixed_sources "${_forge_box2d_source_dir}/${_forge_source}")
 endif()
endforeach()
if(NOT _forge_box2d_replacements EQUAL 1)
 message(FATAL_ERROR "Expected exactly one Box2D snapshot translation unit")
endif()
set_property(TARGET box2d PROPERTY SOURCES "${_forge_box2d_fixed_sources}")
file(SHA256 "${_forge_box2d_snapshot_fixed}" _forge_box2d_compiled_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" _forge_box2d_guard_hash)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/forge-box2d/source.json" CONTENT
 "{\n  \"upstream_commit\": \"178495ba35695aefe9c321e569d2277f06db3b90\",\n  \"upstream_lf_sha256\": \"${_forge_box2d_snapshot_hash}\",\n  \"guard_sha256\": \"${_forge_box2d_guard_hash}\",\n  \"compiled_sha256\": \"${_forge_box2d_compiled_hash}\"\n}\n" @ONLY)
