# Shared actual ImGui authoring regression; no native editor host is required.
include_guard(GLOBAL)
function(forge_add_material_animation_editor_test)
 if(TARGET forge_animation_material_editor_tests)
  return()
 endif()
 add_executable(forge_animation_material_editor_tests tests/animation_material_editor_tests.cpp)
 target_include_directories(forge_animation_material_editor_tests PRIVATE src src/editor)
 target_compile_definitions(forge_animation_material_editor_tests PRIVATE FORGE_UI_FIXTURE UNICODE _UNICODE NOMINMAX)
 target_link_libraries(forge_animation_material_editor_tests PRIVATE forge_animation forge_runtime_resources forge_transform_animation_authoring forge_texture_authoring imgui SDL3::SDL3)
 if(COMMAND copy_required_dlls)
  copy_required_dlls(forge_animation_material_editor_tests)
 endif()
 add_test(NAME animation_material_editor COMMAND forge_animation_material_editor_tests "${CMAKE_BINARY_DIR}/animation-material-ui-tests")
 set_tests_properties(animation_material_editor PROPERTIES TIMEOUT 120)
endfunction()
