# Existing property/guide owners need ImGui and SDL, but no graphics device.
if(BUILD_TESTING AND (FORGE_BUILD_EDITOR OR FORGE_BUILD_MCP_EDITOR_TESTS))
 foreach(kind overlay inspector)
  add_executable(forge_physics_2d_${kind}_tests tests/physics_2d_${kind}_tests.cpp)
  target_include_directories(forge_physics_2d_${kind}_tests PRIVATE src src/editor)
  target_compile_definitions(forge_physics_2d_${kind}_tests PRIVATE UNICODE _UNICODE NOMINMAX)
  target_link_libraries(forge_physics_2d_${kind}_tests PRIVATE forge_physics forge_authoring imgui SDL3::SDL3)
  if(FORGE_BUILD_EDITOR)
   copy_required_dlls(forge_physics_2d_${kind}_tests)
  endif()
  add_test(NAME physics_2d_${kind} COMMAND forge_physics_2d_${kind}_tests "${CMAKE_BINARY_DIR}/physics-2d-${kind}-tests")
  set_tests_properties(physics_2d_${kind} PROPERTIES TIMEOUT 30)
 endforeach()
 target_link_libraries(forge_physics_2d_overlay_tests PRIVATE forge_tile_map_cook)
endif()
