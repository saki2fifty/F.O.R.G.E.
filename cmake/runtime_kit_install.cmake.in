# Script/install mode: exact built executables plus CMake's native dependency
# resolver. No hand-written PE parser and no recursive copy of a developer bin dir.
cmake_policy(PUSH)
# Exact pinned CMake normalizes mixed Win32 separators only under this policy.
# Otherwise the System32 exclusion misses OS DLLs and recursively scans the OS.
cmake_policy(SET CMP0207 NEW)
if(NOT WIN32 OR "@CMAKE_BUILD_TYPE@" STREQUAL "Debug")
 message(FATAL_ERROR "Standalone runtime kits currently require a Windows non-Debug build")
endif()
set(_destination "${CMAKE_INSTALL_PREFIX}")
if(EXISTS "${_destination}/forge.runtime-kit.json")
 message(FATAL_ERROR "Use a new runtime-kit staging directory; never replace a validated kit in place")
endif()
file(MAKE_DIRECTORY "${_destination}")
file(TO_CMAKE_PATH "$ENV{SystemRoot}" _system_root)
file(GET_RUNTIME_DEPENDENCIES
 EXECUTABLES "${FORGE_KIT_GAME}"
 LIBRARIES "${FORGE_KIT_D3D12}"
 DIRECTORIES "@CMAKE_BINARY_DIR@"
 RESOLVED_DEPENDENCIES_VAR _resolved
 UNRESOLVED_DEPENDENCIES_VAR _unresolved
 CONFLICTING_DEPENDENCIES_PREFIX _conflicts
 PRE_EXCLUDE_REGEXES "^api-ms-.*" "^ext-ms-.*"
 POST_EXCLUDE_REGEXES "${_system_root}/[Ss][Yy][Ss][Tt][Ee][Mm]32/.*")
if(_unresolved OR _conflicts_FILENAMES)
 message(FATAL_ERROR "Runtime dependency resolution failed: ${_unresolved}; conflicts: ${_conflicts_FILENAMES}")
endif()
set(_files "${FORGE_KIT_GAME}" "${FORGE_KIT_D3D12}" ${_resolved} "@CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS@")
list(REMOVE_DUPLICATES _files)
foreach(_file IN LISTS _files)
 get_filename_component(_name "${_file}" NAME)
 if(EXISTS "${_destination}/${_name}")
  file(SHA256 "${_destination}/${_name}" _existing)
  file(SHA256 "${_file}" _incoming)
  if(NOT _existing STREQUAL _incoming)
   message(FATAL_ERROR "Runtime DLL filename collision: ${_name}")
  endif()
 else()
  file(COPY_FILE "${_file}" "${_destination}/${_name}")
 endif()
endforeach()
file(COPY "@PROJECT_SOURCE_DIR@/resources/ui" DESTINATION "${_destination}/resources")
# Keep the already-selected dependency notices; no headers, tools or source data.
foreach(_root IN ITEMS @FORGE_RUNTIME_LICENSE_ROOTS@)
 get_filename_component(_dependency "${_root}" NAME)
 file(GLOB_RECURSE _notices LIST_DIRECTORIES FALSE "${_root}/*")
 foreach(_notice IN LISTS _notices)
  file(RELATIVE_PATH _relative "${_root}" "${_notice}")
  if(_relative MATCHES "(^|/)\\.git/")
   continue()
  endif()
  get_filename_component(_name "${_notice}" NAME)
  string(TOLOWER "${_name}" _lower)
  if(_lower MATCHES "license|^copying|^notice|^ftl\\.txt$|^patents$|^authors$" OR _relative MATCHES "(^|/)LICENSES/")
   get_filename_component(_directory "${_relative}" DIRECTORY)
   file(MAKE_DIRECTORY "${_destination}/licenses/${_dependency}/${_directory}")
   file(COPY_FILE "${_notice}" "${_destination}/licenses/${_dependency}/${_relative}")
  endif()
 endforeach()
endforeach()
set(_manifest "{\"format\":\"forge.runtime-kit\",\"version\":1,\"executable\":\"forge_game.exe\",\"target\":{\"platform\":\"windows\",\"backend\":\"d3d12\"},\"engine\":{\"build_id\":\"@FORGE_BUILD_ID@\",\"source_commit\":\"@FORGE_SOURCE_COMMIT@\",\"profile\":\"@FORGE_LINKAGE_PROFILE@\",\"sdk_fingerprint\":\"@FORGE_NATIVE_SDK_FINGERPRINT@\"},\"files\":{}}")
file(GLOB_RECURSE _inventory LIST_DIRECTORIES FALSE RELATIVE "${_destination}" "${_destination}/*")
foreach(_relative IN LISTS _inventory)
 file(SHA256 "${_destination}/${_relative}" _digest)
 file(SIZE "${_destination}/${_relative}" _size)
 string(JSON _manifest SET "${_manifest}" files "${_relative}" "{\"sha256\":\"${_digest}\",\"bytes\":${_size}}")
endforeach()
file(WRITE "${_destination}/forge.runtime-kit.json" "${_manifest}\n")
cmake_policy(POP)
