# GPU-independent fixtures use actual editor owners; never link ImGui into games.
if(BUILD_TESTING AND (FORGE_BUILD_EDITOR OR FORGE_BUILD_MCP_EDITOR_TESTS))
 if(NOT FORGE_BUILD_ASSET_TOOLS OR NOT FORGE_BUILD_GAME_PLATFORM)
  message(FATAL_ERROR "MCP editor-owner tests require FORGE_BUILD_ASSET_TOOLS and FORGE_BUILD_GAME_PLATFORM")
 endif()
 include(cmake/imgui.cmake)
 add_executable(forge_mcp_document_host tests/mcp_document_host.cpp)
 target_include_directories(forge_mcp_document_host PRIVATE src src/editor)
 target_link_libraries(forge_mcp_document_host PRIVATE forge_mcp forge_authoring SDL3::SDL3 imgui)
 add_test(NAME mcp_document_stdio COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/mcp_document_test.py $<TARGET_FILE:forge_tools> $<TARGET_FILE:forge_mcp_document_host> "${CMAKE_CURRENT_BINARY_DIR}/mcp-document-protocol-capture.json")
 set_tests_properties(mcp_document_stdio PROPERTIES TIMEOUT 90)
 add_executable(forge_mcp_asset_host tests/mcp_asset_host.cpp)
 target_include_directories(forge_mcp_asset_host PRIVATE src src/editor)
 target_link_libraries(forge_mcp_asset_host PRIVATE forge_mcp forge_authoring forge_import_authoring forge_model_placement forge_asset_files SDL3::SDL3 imgui)
 add_dependencies(forge_mcp_asset_host gltf2ozz forge_asset_build_worker)
 add_test(NAME mcp_asset_stdio COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/mcp_asset_test.py $<TARGET_FILE:forge_tools> $<TARGET_FILE:forge_mcp_asset_host> $<TARGET_FILE:forge_asset_build_worker> $<TARGET_FILE:gltf2ozz> "${CMAKE_CURRENT_BINARY_DIR}/mcp-asset-protocol-capture.json")
 set_tests_properties(mcp_asset_stdio PROPERTIES TIMEOUT 180)
endif()
