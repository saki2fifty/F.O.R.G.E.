 include(InstallRequiredSystemLibraries)
 set(FORGE_RUNTIME_LICENSE_ROOTS "")
 foreach(dependency flecs json sdl diligent jolt box2d miniaudio ozz recast rmlui freetype ktx webp meshoptimizer draco ufbx)
  if(DEFINED ${dependency}_SOURCE_DIR)
   string(APPEND FORGE_RUNTIME_LICENSE_ROOTS " \"${${dependency}_SOURCE_DIR}\"")
  endif()
 endforeach()
 # The manifest advertises the same private UI protocol as this exact host.
