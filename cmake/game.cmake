# Installation produces a source-independent runtime kit for the exporter.
# Shared/static profiles are separate exact builds, not interchangeable DLL sets.
if(WIN32)
 set(_forge_prior_runtime_skip "${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP}")
 set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
 include(InstallRequiredSystemLibraries)
 set(FORGE_RUNTIME_LICENSE_ROOTS "")
 foreach(dependency flecs json sdl diligent jolt box2d miniaudio ozz recast rmlui freetype ktx webp meshoptimizer draco)
  if(DEFINED ${dependency}_SOURCE_DIR)
   string(APPEND FORGE_RUNTIME_LICENSE_ROOTS " \"${${dependency}_SOURCE_DIR}\"")
  endif()
 endforeach()
 # The manifest advertises the same private UI protocol as this exact host.
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/include/forge/ui_protocol.hpp")
 file(READ "${PROJECT_SOURCE_DIR}/include/forge/ui_protocol.hpp" _forge_ui_protocol)
 string(REGEX MATCH "inline constexpr unsigned version = ([0-9]+);" _forge_ui_match "${_forge_ui_protocol}")
 if(NOT _forge_ui_match)
  message(FATAL_ERROR "Cannot determine the graphical runtime UI protocol")
 endif()
 set(FORGE_RUNTIME_UI_PROTOCOL "${CMAKE_MATCH_1}")
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/ui_filter_profile.hpp")
 file(READ "${PROJECT_SOURCE_DIR}/src/ui_filter_profile.hpp" _forge_ui_filters)
