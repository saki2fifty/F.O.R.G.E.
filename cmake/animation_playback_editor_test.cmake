# Live playback controls are shared by the editor and GPU-independent UI fixtures.
include_guard(GLOBAL)
function(forge_add_animation_playback_editor_test)
 if(TARGET forge_animation_playback_editor_tests)
  return()
 endif()
 add_executable(forge_animation_playback_editor_tests tests/animation_playback_editor_tests.cpp)
 target_include_directories(forge_animation_playback_editor_tests PRIVATE src src/editor)
 target_compile_definitions(forge_animation_playback_editor_tests PRIVATE FORGE_UI_FIXTURE UNICODE _UNICODE NOMINMAX)
 target_link_libraries(forge_animation_playback_editor_tests PRIVATE forge_core imgui)
 if(COMMAND copy_required_dlls)
  copy_required_dlls(forge_animation_playback_editor_tests)
 endif()
 add_test(NAME animation_playback_editor COMMAND forge_animation_playback_editor_tests)
 set_tests_properties(animation_playback_editor PROPERTIES TIMEOUT 60)
endfunction()
