# Shared Timeline UI regression; the native editor host is not required.
include_guard(GLOBAL)
function(forge_add_animation_sequence_editor_test)
 if(TARGET forge_animation_sequence_editor_tests)
  return()
 endif()
 get_target_property(_forge_sequence_imgui_root imgui INTERFACE_INCLUDE_DIRECTORIES)
 add_executable(forge_animation_sequence_editor_tests tests/animation_sequence_editor_tests.cpp "${_forge_sequence_imgui_root}/backends/imgui_impl_sdlrenderer3.cpp")
 target_include_directories(forge_animation_sequence_editor_tests PRIVATE src src/editor)
 target_compile_definitions(forge_animation_sequence_editor_tests PRIVATE FORGE_UI_FIXTURE UNICODE _UNICODE NOMINMAX)
 target_link_libraries(forge_animation_sequence_editor_tests PRIVATE forge_animation forge_runtime_resources forge_transform_animation_authoring forge_texture_authoring imgui SDL3::SDL3)
 if(COMMAND copy_required_dlls)
  copy_required_dlls(forge_animation_sequence_editor_tests)
 endif()
 add_test(NAME animation_sequence_editor COMMAND forge_animation_sequence_editor_tests "${CMAKE_CURRENT_SOURCE_DIR}/samples/projects/FeatureGallery" "${CMAKE_BINARY_DIR}/animation-sequence-editor-tests")
 set_tests_properties(animation_sequence_editor PROPERTIES TIMEOUT 180)
 add_test(NAME sequence_property_editor COMMAND forge_animation_sequence_editor_tests --capture-properties "${CMAKE_CURRENT_SOURCE_DIR}/samples/projects/FeatureGallery" "${CMAKE_BINARY_DIR}/sequence-property-editor-tests" "${CMAKE_BINARY_DIR}/sequence-property-editor.png")
 set_tests_properties(sequence_property_editor PROPERTIES TIMEOUT 60 ENVIRONMENT "SDL_VIDEODRIVER=dummy")
 add_test(NAME sequence_binding_editor COMMAND forge_animation_sequence_editor_tests --capture-bindings "${CMAKE_CURRENT_SOURCE_DIR}/samples/projects/FeatureGallery" "${CMAKE_BINARY_DIR}/sequence-binding-editor-tests" "${CMAKE_BINARY_DIR}/sequence-binding-editor.png")
 set_tests_properties(sequence_binding_editor PROPERTIES TIMEOUT 60 ENVIRONMENT "SDL_VIDEODRIVER=dummy")
 add_test(NAME skeletal_sequence_editor COMMAND forge_animation_sequence_editor_tests --skeletal "${CMAKE_CURRENT_SOURCE_DIR}/samples/projects/FeatureGallery" "${CMAKE_BINARY_DIR}/skeletal-sequence-editor-tests" "${CMAKE_BINARY_DIR}/skeletal-sequence-editor.png")
 set_tests_properties(skeletal_sequence_editor PROPERTIES TIMEOUT 60 ENVIRONMENT "SDL_VIDEODRIVER=dummy")
endfunction()
