+
+CommandContext::DynamicDescriptorTable CommandContext::CopyDynamicGPUVisibleDescriptors(
+    ID3D12Device*               pd3d12Device,
+    D3D12_DESCRIPTOR_HEAP_TYPE  Type,
+    Uint32                      Count,
+    D3D12_CPU_DESCRIPTOR_HANDLE Source,
+    DynamicDescriptorKey        Key)
+{
+    if (pd3d12Device == nullptr || m_DynamicGPUDescriptorAllocators == nullptr ||
+        (Type != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV && Type != D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER) ||
+        Count == 0 || Source.ptr == 0 || (!Key.empty() && Key.size() != Count))
+        LOG_ERROR_AND_THROW("Invalid dynamic descriptor snapshot request");
+    auto& Cache = m_DynamicDescriptorTables[Type];
+    if (!Key.empty())
+    {
+        const auto Found = Cache.find(Key);
+        if (Found != Cache.end())
+            return Found->second;
+    }
+    auto Allocation = AllocateDynamicGPUVisibleDescriptor(Type, Count);
+    if (Allocation.IsNull())
+        LOG_ERROR_AND_THROW("Dynamic GPU-visible descriptor budget exhausted for ", Count,
+                            Type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER ? " samplers" : " CBV/SRV/UAV resources");
+    pd3d12Device->CopyDescriptorsSimple(Count, Allocation.GetCpuHandle(), Source, Type);
+    DynamicDescriptorTable Table;
+    Table.pHeap          = Allocation.GetDescriptorHeap();
+    Table.GPU            = Allocation.GetGpuHandle();
+    Table.DescriptorSize = Allocation.GetDescriptorSize();
+    if (!Key.empty())
+        Cache.emplace(std::move(Key), Table);
+    // Free() only resets this suballocation wrapper. Its chunk stays live until
+    // the owning allocator retires the frame using the original queue fences.
+    return Table;
 }

