include_guard(GLOBAL)
# One shared FORGE C boundary for texture import and runtime UI. Retain the
# selected DiligentTools libpng/stb/zlib sources; no codec implementation is copied.
if(NOT TARGET PNG::PNG)
 include(cmake/diligent_source.cmake)
 FetchContent_GetProperties(diligent)
 if(NOT diligent_POPULATED)
  cmake_policy(PUSH)
  cmake_policy(SET CMP0169 OLD)
  FetchContent_Populate(diligent)
  cmake_policy(POP)
 endif()
 set(ZLIB_BUILD_TESTING OFF CACHE BOOL "No codec examples" FORCE)
 set(ZLIB_BUILD_SHARED OFF CACHE BOOL "Static runtime image codec" FORCE)
 set(ZLIB_BUILD_STATIC ON CACHE BOOL "Static runtime image codec" FORCE)
 set(ZLIB_INSTALL OFF CACHE BOOL "FORGE owns installation" FORCE)
 add_subdirectory("${diligent_SOURCE_DIR}/DiligentTools/ThirdParty/zlib" "${CMAKE_BINARY_DIR}/forge-image-zlib" EXCLUDE_FROM_ALL)
 if(NOT TARGET ZLIB::ZLIB)
  add_library(ZLIB::ZLIB ALIAS zlibstatic)
 endif()
 set(ZLIB_INCLUDE_DIR "${diligent_SOURCE_DIR}/DiligentTools/ThirdParty/zlib" CACHE PATH "Selected image codec headers" FORCE)
 set(ZLIB_LIBRARY zlibstatic CACHE STRING "Selected static image codec" FORCE)
 set(PNG_SHARED OFF CACHE BOOL "Static runtime image codec" FORCE)
 set(PNG_STATIC ON CACHE BOOL "Static runtime image codec" FORCE)
 set(PNG_TOOLS OFF CACHE BOOL "No codec tools" FORCE)
 set(PNG_TESTS OFF CACHE BOOL "No codec examples" FORCE)
 # Keep upstream's install option local to this dependency configuration.
 block()
  set(SKIP_INSTALL_ALL ON)
  add_subdirectory("${diligent_SOURCE_DIR}/DiligentTools/ThirdParty/libpng" "${CMAKE_BINARY_DIR}/forge-image-png" EXCLUDE_FROM_ALL)
 endblock()
 add_library(PNG::PNG ALIAS png_static)
endif()
add_library(forge_image_codecs STATIC src/texture_png.c src/texture_png_encode.c src/texture_jpeg.c)
target_include_directories(forge_image_codecs PRIVATE "${diligent_SOURCE_DIR}/DiligentTools/ThirdParty/stb")
target_link_libraries(forge_image_codecs PRIVATE PNG::PNG)
set_target_properties(forge_image_codecs PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_link_libraries(forge_ui_assets PRIVATE forge_image_codecs)
add_library(forge_view_image STATIC src/view_image.cpp)
target_include_directories(forge_view_image PUBLIC src)
target_link_libraries(forge_view_image PRIVATE forge_image_codecs forge_file_storage)
if(BUILD_TESTING)
 add_executable(forge_png_encode_tests tests/png_encode_tests.cpp)
 target_include_directories(forge_png_encode_tests PRIVATE src)
 target_link_libraries(forge_png_encode_tests PRIVATE forge_image_codecs forge_view_image)
 add_test(NAME image_png_encode COMMAND forge_png_encode_tests "${CMAKE_BINARY_DIR}/image-png-encode")
 set_tests_properties(image_png_encode PROPERTIES TIMEOUT 30)
endif()
set(_forge_image_components Runtime)
if(FORGE_ENABLE_NATIVE_SDK)
 list(APPEND _forge_image_components NativeSdk)
endif()
foreach(component IN LISTS _forge_image_components)
 set(_forge_image_notice_destination share/forge/licenses)
 if(component STREQUAL "NativeSdk")
  set(_forge_image_notice_destination licenses)
 endif()
 install(FILES "${diligent_SOURCE_DIR}/DiligentTools/ThirdParty/libpng/LICENSE" DESTINATION ${_forge_image_notice_destination} COMPONENT ${component} RENAME libpng.txt)
 install(FILES "${diligent_SOURCE_DIR}/DiligentTools/ThirdParty/zlib/README" DESTINATION ${_forge_image_notice_destination} COMPONENT ${component} RENAME zlib.txt)
 install(FILES "${diligent_SOURCE_DIR}/DiligentTools/ThirdParty/stb/LICENSE" DESTINATION ${_forge_image_notice_destination} COMPONENT ${component} RENAME stb.txt)
endforeach()
unset(_forge_image_components)
unset(_forge_image_notice_destination)
