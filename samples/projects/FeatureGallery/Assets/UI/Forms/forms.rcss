body { width:100%;height:100%;font-family:Lato;font-size:18px;color:#e6eff7;pointer-events:none; }
body,div,p { display:block; }
#panel { position:absolute;left:5%;top:4%;width:90%;max-width:650px;max-height:92%;padding:22px;box-sizing:border-box;overflow:auto;background-color:#152d3f;pointer-events:auto; }
p { margin:10px 0; }
#eyebrow { color:#79dcc4;font-size:14px; }
#heading { color:#ffffff;font-size:28px; }
.section { display:block;margin-top:17px;margin-bottom:8px;font-size:14px;color:#9dbbce; }
.row { margin:10px 0; }
input { display:inline-block;width:20px;height:20px;margin-right:12px;vertical-align:middle;background-color:#0c1e2b;border:2px #7297b0; }
input:checked { background-color:#63d3b3;border-color:#b6f3e1; }
input:focus,select:focus { border-color:#ffce6d; }
input:disabled { background-color:#223747;border-color:#526575; }
label { vertical-align:middle; }
select { display:block;width:92%;height:34px;background-color:#24465e;border:2px #7297b0; }
selectvalue { padding:5px 9px; }
selectarrow { width:20px;background-color:#7297b0; }
selectbox { background-color:#19374e;border:2px #7297b0; }
option { padding:7px 9px; }
option:hover,option:checked { background-color:#38647f; }
option:disabled { color:#748b9e; }
progress { display:block;width:92%;height:18px;background-color:#0c1e2b; }
progress fill { background-color:#63d3b3; }
#hint { color:#b9ccda;font-size:15px;line-height:1.4; }
scrollbarvertical { width:10px;background-color:#0c1e2b; }
scrollbarvertical sliderbar { background-color:#7297b0; }
