<!-- FORGE source authoring example -->
<rml><head><link type="text/rcss" href="hud.rcss" /></head><body id="canvas"><div id="panel"><p id="eyebrow">FORGE / UI SOURCE AUTHORING</p><p id="heading">Edit the source. Run the result.</p><p id="message">Text &amp; markup: &lt;your own HUD&gt;</p><p id="state">Tick {{tick}} / paused {{paused}}</p><button id="Pause" data-event-click="command('Pause')">Pause</button><button id="Resume" data-event-click="command('Resume')">Resume</button><button id="Step" data-event-click="command('Step')">Step</button><input id="name" type="text" value="Your name"/><p id="hint">Stop Play. In Content, edit hud.rml with Source or Elements. Save, then start Play again. Edit hud.rcss to change layout and colors.</p></div></body></rml>
